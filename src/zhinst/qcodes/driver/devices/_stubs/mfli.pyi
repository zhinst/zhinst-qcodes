    currins: ZIChannelList[MFLICurrins]
    demods: ZIChannelList[MFLIDemods]
    dios: ZIChannelList[MFLIDios]
    extrefs: ZIChannelList[MFLIExtrefs]
    features: MFLIFeatures
    imps: ZIChannelList[MFLIImps]
    mods: ZIChannelList[MFLIMods]
    oscs: ZIChannelList[MFLIOscs]
    pids: ZIChannelList[MFLIPids]
    scopes: ZIChannelList[MFLIScopes]
    sigins: ZIChannelList[MFLISigins]
    sigouts: ZIChannelList[MFLISigouts]
    stats: MFLIStats
    status: MFLIStatus
    system: MFLISystem
    triggers: MFLITriggers
    tu: MFLITu
